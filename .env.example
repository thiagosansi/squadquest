# SquadQuest Supabase project: replace-your-project-ref
# Copy this file to .env.local and fill in the public publishable key from Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://replace-your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-with-your-project-key

# Legacy NEXT_PUBLIC_SUPABASE_ANON_KEY is also accepted during migration.
# When the URL or both keys are blank, SquadQuest uses its local multi-tab demo transport.
